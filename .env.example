# Local demo. Keep disabled mode on loopback.
SOC_API_AUTH_MODE=disabled
SOC_API_HOST=127.0.0.1
SOC_API_PORT=8000
SOC_COOKIE_SECURE=true
SOC_EXPORT_MAX_REQUESTS_PER_MINUTE=12

# Live demo. Set SOC_API_AUTH_MODE=token, configure the exact public HTTPS origin
# for both lists, and provide distinct service and analyst credentials.
# SOC_ALLOWED_ORIGINS=https://sham.example.invalid
# SOC_WEBSOCKET_ALLOWED_ORIGINS=https://sham.example.invalid
# FORWARDED_ALLOW_IPS=127.0.0.1
SOC_API_SERVICE_TOKEN=
SOC_UI_TOKEN=
SOC_REVIEW_API_TOKEN=
SOC_API_BEARER_TOKEN=
SOC_API_TOKENS_JSON={}
# SOC_STREAM_API_URL=http://127.0.0.1:8000/api/broadcast

# SOC_ASSET_INVENTORY_PATH=configs/asset_inventory.example.json
WAZUH_INDEXER_HOST=https://localhost:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASS=
WAZUH_INDEXER_VERIFY_TLS=true
# WAZUH_INDEXER_CA_CERTS=/path/to/trusted-wazuh-root-ca.pem
# WAZUH_API_HOST=https://127.0.0.1:55000
WAZUH_API_USER=
WAZUH_API_PASS=
WAZUH_API_VERIFY_TLS=true
SOC_ALLOW_INSECURE_TLS_LAB=false

SOC_THEHIVE_AUTO_CREATE=false
THEHIVE_API_KEY=
