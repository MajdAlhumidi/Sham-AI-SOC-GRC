{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCloudTrailPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<CLOUDTRAIL_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "<CLOUDTRAIL_PREFIX>*"
        }
      }
    },
    {
      "Sid": "ReadCloudTrailObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<CLOUDTRAIL_BUCKET>/<CLOUDTRAIL_PREFIX>*"
    },
    {
      "Sid": "ReadDesignatedCloudWatchGroup",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:<LOG_GROUP>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<REGION>"
        }
      }
    },
    {
      "Sid": "ReadDesignatedCloudWatchStreams",
      "Effect": "Allow",
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:<LOG_GROUP>:log-stream:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<REGION>"
        }
      }
    },
    {
      "Sid": "LookupRegionalCloudTrailEvents",
      "Effect": "Allow",
      "Action": "cloudtrail:LookupEvents",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<REGION>"
        }
      }
    }
  ]
}
